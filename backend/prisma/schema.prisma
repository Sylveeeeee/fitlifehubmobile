generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  name         String?
  passwordHash String
  birthday     DateTime?
  sex          String?
  height       Float?
  weight       Float?
  bodyFat      Float?
  caloriesGoal Int?
  baseEnergyNeed Int?
  activityCalories Int?
  proteinGoal  Float?
  fatGoal      Float?
  carbsGoal    Float?
  activityLevel String?
  goalRate     Int?
  goalWeight   Float?
  createdAt    DateTime  @default(now())

  foodEntries FoodEntry[]
  exerciseEntries ExerciseEntry[]
  dailyGoals DailyGoal[]
}

model DailyGoal {
  id        Int      @id @default(autoincrement())
  userId    Int
  date      DateTime
  calories  Int
  protein   Float    @default(0)
  fat       Float    @default(0)
  carbs     Float    @default(0)
  exerciseCalories Int     @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  @@unique([userId, date], name: "userId_date")
}

model Food {
  id        Int      @id @default(autoincrement())
  foodName  String   @unique
  calories  Float
  protein   Float
  carbs     Float
  fat       Float
  category  String?
  createdAt DateTime @default(now())

  entries FoodEntry[] // ความสัมพันธ์ไปยัง entry ของผู้ใช้
}

model FoodEntry {
  id       Int      @id @default(autoincrement())
  userId   Int
  foodId   Int
  quantity Float // จำนวนที่กิน เช่น 1.5 serving
  mealType String // Breakfast / Lunch / Dinner / Snack
  date     DateTime

  user User @relation(fields: [userId], references: [id])
  food Food @relation(fields: [foodId], references: [id])
}

model ExerciseEntry {
  id           Int      @id @default(autoincrement())
  user         User     @relation(fields: [userId], references: [id])
  userId       Int
  category     ExerciseCategory  // เช่น Cardio, Strength
  type         ExerciseType      // เช่น Running, Swimming, Walking
  duration     Int      // นาที
  calories     Float    // kcal ที่เผาผลาญ
  timestamp    DateTime @default(now())
  note         String?  // ข้อความเพิ่มเติม
  mealType String // Breakfast / Lunch / Dinner / Snack
}

enum ExerciseCategory {
  Cardio
  Gym
  Strength
  Flexibility
  Balance
  Other
}

enum ExerciseType {
  // Cardio
  Running
  Swimming
  Walking
  Cycling
  HIIT
  


  // Gym/Strength
  BenchPress
  Squat
  Deadlift
  PullUp
  PushUp
  ShoulderPress
  Row
  BicepCurl
  TricepExtension
  LegPress
  Lunges
  Plank
  weighttraining
  Bodyweight
  CrossFit

  // Flexibility/Balance
  Yoga
  Stretching
  Pilates
  BalanceBoard

  // Other
  Weightlifting
  Other
}
